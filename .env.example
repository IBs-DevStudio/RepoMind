# ==========================================
# Database (PostgreSQL / Neon / Prisma)
# ==========================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/github-codebase-ai"

# ==========================================
# Clerk Authentication
# ==========================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
